  ],
  "author": "Ekrem Güngör",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Ekrem-Gungor/edefter-local-viewer/issues"
  },
  "homepage": "https://github.com/Ekrem-Gungor/edefter-local-viewer#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
